{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:daily"
  ],
  "commitMessageExtra": "{{{currentValue}}} to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}}",
  "packageRules": [
    {
      "description": "Metro is a Kotlin compiler plugin, so a Kotlin bump usually needs a matching Metro release",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin[.:]/",
        "/^dev\\.zacsweers\\.metro([.:]|$)/"
      ],
      "groupName": "kotlin"
    },
    {
      "description": "AGP, the lint plugin and lint-api ship together and must stay on the same release",
      "matchPackageNames": [
        "/^com\\.android\\.tools\\.build:gradle$/",
        "/^com\\.android\\.(application|library|kotlin\\.multiplatform\\.library|lint)([.:]|$)/",
        "/^com\\.android\\.tools\\.lint:/"
      ],
      "groupName": "android gradle plugin"
    },
    {
      "description": "ktlintCore must match the ktlint that kotlinter bundles, so the custom ruleset links against the same API",
      "matchPackageNames": [
        "/^org\\.jmailen\\./",
        "/^com\\.pinterest\\.ktlint:/"
      ],
      "groupName": "kotlinter"
    },
    {
      "description": "Compose Multiplatform artifacts are one release train spread over several catalog versions",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.compose([.:]|$)/"
      ],
      "groupName": "compose multiplatform"
    }
  ]
}
